{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "webpage-capture-for-lzengan",
  "title": "Webpage Capture for Lzengan",
  "description": "Capture the current browser page as Markdown with local images",
  "icon": "icon.png",
  "author": "li_zeng",
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Productivity"
  ],
  "commands": [
    {
      "name": "capture-webpage-as-md-for-lzengan",
      "title": "Capture webpage as .md for lzengan",
      "subtitle": "Markdown with Local Images",
      "description": "Capture the active browser page as a local Markdown file with downloaded images",
      "mode": "no-view"
    }
  ],
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@raycast/api": "1.104.25",
    "linkedom": "^0.18.13",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/turndown": "^5.0.6",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "build": "ray build -e dist -o dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "test:bundle": "node tests/bundle-smoke.cjs"
  },
  "overrides": {
    "@types/react": "$@types/react",
    "@raycast/api": {
      "esbuild": "0.28.2"
    },
    "@oclif/core": {
      "minimatch": "11.0.9"
    }
  }
}
